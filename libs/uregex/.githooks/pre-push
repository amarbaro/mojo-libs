#!/usr/bin/env bash
# rule 1: a push is an explicit act -- PUBLISH_OK=1 must be set by the person pushing; rule 2: gate + publish-check green.
[ "${PUBLISH_OK:-}" = 1 ] || { echo "refusing push: set PUBLISH_OK=1 (publishing standard rule 1)"; exit 1; }
cd "$(git rev-parse --show-toplevel)" && tools/publish-check.sh && tools/gate.sh
